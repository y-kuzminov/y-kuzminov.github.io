		{
			"name": "Positive case 4 symbols -singup",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var randomEmail = \"name\" + Math.floor(Math.random() * 1000000) + \"@gmail.com\";",
							"pm.environment.set('email', randomEmail);",
							"",
							"function generateRandomName(length) {",
							"    var letters = 'abcdefghijklmnopqrstuvwxyz';",
							"    var randomName = Array.from({ length: length }, () => letters.charAt(Math.floor(Math.random() * letters.length))).join('');",
							"    return randomName.charAt(0).toUpperCase() + randomName.slice(1);",
							"}",
							"",
							"var randomName = generateRandomName(4); ",
							"pm.environment.set('name', randomName);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Successful POST request\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([201, 202]);",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"{{name}}\",\n  \"lastName\": \"Test\",\n  \"email\": \"{{email}}\",\n  \"password\": \"Qwerty1!\",\n  \"repeatPassword\": \"Qwerty1!\"\n}"
