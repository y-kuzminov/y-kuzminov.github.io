							"var randomName = generateRandomName(4); ",
							"pm.environment.set('name', randomName);",
							"",
							"",
							"function generateRandomLastName(length) {",
							"    var letters = 'abcdefghijklmnopqrstuvwxyz';",
							"    var randomLastName = Array.from({ length: length }, () => letters.charAt(Math.floor(Math.random() * letters.length))).join('');",
